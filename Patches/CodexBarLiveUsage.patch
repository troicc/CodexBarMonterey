+// Live-only provider payloads used by CodexBarMonterey's bundled CLI JSON.
+// These DTOs intentionally avoid adding Codable conformance to the upstream
+// domain models and are only emitted when the Monterey shell opts in.
+private struct MontereyDeepSeekDailyUsagePayload: Encodable {
+    let date: String
+    let totalTokens: Int
+    let cost: Double?
+    let requestCount: Int
+
+    init(_ value: DeepSeekDailyUsage) {
+        self.date = value.date
+        self.totalTokens = value.totalTokens
+        self.cost = value.cost
+        self.requestCount = value.requestCount
+    }
+}
+
+private struct MontereyDeepSeekUsagePayload: Encodable {
+    let todayTokens: Int
+    let currentMonthTokens: Int
+    let todayCost: Double?
+    let currentMonthCost: Double?
+    let requestCount: Int
+    let currentMonthRequestCount: Int
+    let topModel: String?
+    let daily: [MontereyDeepSeekDailyUsagePayload]
+    let currency: String
+    let updatedAt: Date
+
+    init(_ value: DeepSeekUsageSummary) {
+        self.todayTokens = value.todayTokens
+        self.currentMonthTokens = value.currentMonthTokens
+        self.todayCost = value.todayCost
+        self.currentMonthCost = value.currentMonthCost
+        self.requestCount = value.requestCount
+        self.currentMonthRequestCount = value.currentMonthRequestCount
+        self.topModel = value.topModel
+        self.daily = value.daily.map(MontereyDeepSeekDailyUsagePayload.init)
+        self.currency = value.currency
+        self.updatedAt = value.updatedAt
+    }
+}
+
+private struct MontereyZaiModelDataItemPayload: Encodable {
+    let modelName: String?
+    let tokensUsage: [Int?]
+
+    init(_ value: ZaiModelDataItem) {
+        self.modelName = value.modelName
+        self.tokensUsage = value.tokensUsage
+    }
+}
+
+private struct MontereyZaiModelUsagePayload: Encodable {
+    let xTime: [String]
+    let modelDataList: [MontereyZaiModelDataItemPayload]
+
+    init(_ value: ZaiModelUsageData) {
+        self.xTime = value.xTime
+        self.modelDataList = value.modelDataList.map(MontereyZaiModelDataItemPayload.init)
+    }
+}
+
+private struct MontereyZaiUsagePayload: Encodable {
+    let planName: String?
+    let modelUsage: MontereyZaiModelUsagePayload?
+    let updatedAt: Date
+
+    init(_ value: ZaiUsageSnapshot) {
+        self.planName = value.planName
+        self.modelUsage = value.modelUsage.map(MontereyZaiModelUsagePayload.init)
+        self.updatedAt = value.updatedAt
+    }
+}
+
